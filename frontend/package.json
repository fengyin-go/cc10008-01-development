{
  "name": "interactive-analytics-lab-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "repoKind": "frontend-only",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:invariants": "esbuild test/engine-invariants.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/ei.mjs && node node_modules/.cache/ei.mjs",
    "test:lifecycle": "esbuild test/engine-lifecycle.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/el.mjs && node node_modules/.cache/el.mjs",
    "test:smoke": "esbuild test/component-smoke.tsx --bundle --platform=node --format=cjs --loader:.tsx=tsx --jsx=automatic --outfile=node_modules/.cache/cs.cjs && node node_modules/.cache/cs.cjs",
    "test": "npm run test:invariants && npm run test:lifecycle && npm run test:smoke"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.4.3",
    "vite": "^5.2.6"
  }
}
